+// ---- Mods ------------------------------------------------------------------
+//
+// A .mgm package is a DIRECTORY whose name is the mod ID and which contains
+// the platform library as "mod" (see DiscoverModSources). An optional mod.ini
+// beside that library supplies a display name and version.
+//
+// Reading a plain text file is a deliberate choice over calling
+// moderngekko_get_mod() in each library: loading a third-party DLL executes
+// its DllMain and static initialisers, and doing that merely to render a label
+// would run a mod's code before the user has enabled anything. A mod without a
+// mod.ini simply shows its ID.
+struct ModPackage
+{
+  std::string directory;
+  std::string display_name;
+  std::string version;
+  bool enabled = true;
+};
+
+std::string ModTrim(const std::string& text)
+{
+  const std::size_t first = text.find_first_not_of(" \t");
+  if (first == std::string::npos)
+    return {};
+  const std::size_t last = text.find_last_not_of(" \t\r");
+  return text.substr(first, last - first + 1);
+}
+
+void ReadModManifest(const fs::path& package, ModPackage* out)
+{
+  std::ifstream file(package / "mod.ini");
+  if (!file)
+    return;
+  std::string line;
+  while (std::getline(file, line))
+  {
+    const std::string trimmed = ModTrim(line);
+    if (trimmed.empty() || trimmed[0] == '#' || trimmed[0] == ';' || trimmed[0] == '[')
+      continue;
+    const std::size_t separator = trimmed.find('=');
+    if (separator == std::string::npos)
+      continue;
+    const std::string key = ModTrim(trimmed.substr(0, separator));
+    const std::string value = ModTrim(trimmed.substr(separator + 1));
+    if (key == "name" && !value.empty())
+      out->display_name = value;
+    else if (key == "version" && !value.empty())
+      out->version = value;
+  }
+}
+
+std::vector<ModPackage> ScanModPackages(const std::vector<fs::path>& roots)
+{
+  std::vector<ModPackage> packages;
+  for (const fs::path& root : roots)
+  {
+    std::error_code ec;
+    if (!fs::is_directory(root, ec))
+      continue;
+    for (fs::directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec))
+    {
+      if (!it->is_directory(ec) || it->path().extension() != ".mgm")
+        continue;
+      const std::string name = it->path().filename().string();
+      // The runner resolves a package name against the executable directory
+      // first, so a duplicate in the user directory is shadowed, not listed
+      // twice.
+      if (std::any_of(packages.begin(), packages.end(),
+                      [&](const ModPackage& p) { return p.directory == name; }))
+        continue;
+      ModPackage package;
+      package.directory = name;
+      package.display_name = it->path().stem().string();
+      ReadModManifest(it->path(), &package);
+      packages.push_back(std::move(package));
+    }
+  }
+  std::sort(packages.begin(), packages.end(),
+            [](const ModPackage& a, const ModPackage& b) { return a.directory < b.directory; });
+  return packages;
+}
+
