diff --git a/tools/moderngekko_run.cpp b/tools/moderngekko_run.cpp
index c9a20a5..c494eef 100644
--- a/tools/moderngekko_run.cpp
+++ b/tools/moderngekko_run.cpp
@@ -134,9 +134,17 @@ int RunMain(int argc, char **argv) {
   setenv("SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD", "1", 0);
 #endif
   moderngekko::RuntimeConfig config;
-  config.user_directory = DefaultUserDirectory();
   const std::filesystem::path executable_directory =
       ExecutableDirectory(argv[0]);
+#ifdef MODERNGEKKO_PORTABLE_USER_DIRECTORY
+  // Portable build: keep config, saves and logs beside the executable instead
+  // of in %LOCALAPPDATA% (or Documents, with USER_DIRECTORY_IN_DOCUMENTS), so
+  // the whole thing can be copied or zipped as one folder. Mods are already
+  // read from <exe dir>/Mods, so this makes the layout consistent.
+  config.user_directory = executable_directory / "User";
+#else
+  config.user_directory = DefaultUserDirectory();
+#endif
 #ifdef MODERNGEKKO_DEFAULT_WINDOW_TITLE
   config.window_title = MODERNGEKKO_DEFAULT_WINDOW_TITLE;
 #endif
