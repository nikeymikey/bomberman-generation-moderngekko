+    const auto symbol_map_hash = moderngekko::HashFileSha256(options.symbol_map);
+    if (!symbol_map_hash)
+    {
+      std::cerr << "symbol map is unreadable: " << options.symbol_map << '\n';
+      return std::nullopt;
+    }
+    symbol_map_identity = "|symbol_map=" + *symbol_map_hash;
+  }
