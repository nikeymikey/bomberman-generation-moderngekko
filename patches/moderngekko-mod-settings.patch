+// One setting a mod declares in its mod.ini, as
+//   setting=<key>|<label>|<choice,choice,...>|<default>
+// A fixed choice list rather than free text: the launcher can then present it
+// without knowing anything about the mod, and cannot offer a value the mod
+// never said it accepts.
+struct ModSetting
+{
+  std::string key;
+  std::string label;
+  std::vector<std::string> choices;
+  std::string value;
+};
+
 struct ModPackage
 {
   std::string directory;
+  std::string id;
   std::string display_name;
   std::string version;
+  std::vector<ModSetting> settings;
   bool enabled = true;
 };
 
+std::string ModLower(std::string text)
+{
+  for (char& character : text)
+    character = static_cast<char>(
+        std::tolower(static_cast<unsigned char>(character)));
+  return text;
+}
+
+std::vector<std::string> ModSplit(const std::string& text, char separator)
+{
+  std::vector<std::string> parts;
+  std::size_t start = 0;
+  while (true)
+  {
+    const std::size_t at = text.find(separator, start);
+    parts.push_back(text.substr(start, at == std::string::npos ? std::string::npos : at - start));
+    if (at == std::string::npos)
+      break;
+    start = at + 1;
+  }
+  return parts;
+}
+
+// Settings live in the frontend config keyed "<mod-id>.<key>", so one mod's
+// setting can never collide with another's.
+std::string ModSettingName(const ModPackage& package, const ModSetting& setting)
+{
+  return ModLower(package.id) + "." + ModLower(setting.key);
+}
+
+void SetModSetting(moderngekko::frontend::ConfigResult& config, const std::string& name,
+                   const std::string& value)
+{
+  for (auto& entry : config.mod_settings)
+  {
+    if (entry.first == name)
+    {
+      entry.second = value;
+      return;
+    }
+  }
+  config.mod_settings.emplace_back(name, value);
+}
