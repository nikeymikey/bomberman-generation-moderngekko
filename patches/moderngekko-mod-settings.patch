+  // settings channel, and a mod library cannot reliably locate config.ini from
+  // inside the runner process -- but the runner has both, so it translates.
+  // The name is MGMOD_<MOD-ID>_<KEY> with every non-alphanumeric folded to '_'
+  // and the whole thing upper-cased; a mod derives the same name from its own
+  // id and setting key, so neither side needs a shared table.
+  for (const auto &setting : frontend_config.mod_settings) {
+    std::string variable = "MGMOD_";
+    for (const char character : setting.first) {
+      const unsigned char raw = static_cast<unsigned char>(character);
+      variable += std::isalnum(raw) ? static_cast<char>(std::toupper(raw)) : '_';
+    }
+#if defined(_WIN32)
+    _putenv_s(variable.c_str(), setting.second.c_str());
+#else
+    setenv(variable.c_str(), setting.second.c_str(), 1);
+#endif
+  }
